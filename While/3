using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace ConsoleApplication4
{
    class Program
    {
        static void Main(string[] args)
        {
            Console.Write("ingrese un numero entero para sumar a la alcancia: ");
            int num = int.Parse(Console.ReadLine());
            int con = 0;
            while (num > 0)
            {
                con = con + num;
                Console.Write("ingrese un numero entero para sumar a la alcancia: ");
                num = int.Parse(Console.ReadLine());
            }
            Console.WriteLine("el total acumulado es " + con + "");
        }
    }
}
