        }
        static int determinar_menor(int m, int n)
        {
            if (n < m)
            {
                m = n;
            }
            return m;
        }
        static int promedio(int o, int suma)
        {
            suma = suma / o;
            return suma;
        }
        static int determinar_par(int num)
        {
            num = num % 2;
            return num;
        }
