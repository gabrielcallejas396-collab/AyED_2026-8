using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace ConsoleApplication1
{
    class Program
    {
        static void Main(string[] args)
        {
            int pro = 0;
            int baja = 100;
            int alta = 0;
            int[] temperatura = new int[7];
            for (int i = 0; i < temperatura.Length; i++)
            {
                Console.Write("ingrese la temperatura de hoy: ");
                temperatura[i] = int.Parse(Console.ReadLine());
                pro = pro + temperatura[i];
                if (temperatura[i] < baja)
                {
                    baja = temperatura[i];
                }
                if (temperatura[i] > alta)
                {
                    alta = temperatura[i];
                }
            }
            int promedio = pro / 7;
            Console.WriteLine("la temperatura mas baja de la semana es de " + baja + " grados, la mas alta de la semana es de " + alta + " grados y el promedio es de " + promedio + " grados");
        }
    }
}
