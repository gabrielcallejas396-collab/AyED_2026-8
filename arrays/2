using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace ConsoleApplication2
{
    class Program
    {
        static void Main(string[] args)
        {
            int pro = 0;
            int aprovados = 0;
            int reprovados = 0;
            int[] alumnos = new int[10];
            for (int i = 0 ; i < alumnos.Length;  i++)
            {
                Console.Write("ingrese la nota del alumno: ");
                alumnos[i] = int.Parse(Console.ReadLine());
                pro = pro + alumnos[i];
                if (alumnos[i] >= 6)
                {
                    aprovados++;
                }
                else
                {
                    reprovados++;
                }
            }
            int promedio = pro / 10;
            Console.WriteLine("ahi " + aprovados + " alumnos aprovados y " + reprovados + " reprovados el promedio general es de " + promedio + "");
        }
    }
}
