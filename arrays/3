                {
                    A++;
                }
                if (clases[i] == "p" || clases[i] == "P")
                {
                    P++;
                }
            }
            if (A > 6)
            {
                Console.WriteLine("el alumno quedo libre");
            }
            else
            {
                Console.WriteLine("alumno regular");
            }
        }
