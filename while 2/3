using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace ConsoleApplication1
{
    class Program
    {
        static void Main(string[] args)
        {
            int monto = 0;
            int opcion = 0;
            int ventas = 0;
            int mayor = 0;
            while (opcion != 3)
            {
                Console.WriteLine("1) monto de la venta");
                Console.WriteLine("desea continuar ingresando mas ventas?");
                Console.WriteLine("2) si");
                Console.WriteLine("3) no");
                Console.Write("que desea hacer?: ");
                opcion = int.Parse(Console.ReadLine());
                switch (opcion)
                {
                    case 1:              
                        Console.WriteLine("" + monto + " pesos es el monto acumulado");
                        opcion = 1;
                        break;
                    case 2:
                        
                        ventas++;
                        Console.Write("ingrese el valor de la compra: ");
                        int valor = int.Parse(Console.ReadLine());
                        monto = monto + valor;
                        if (ventas == 1)
                        {
                            mayor = valor;
                        }
                        if (valor > mayor )
                        {
                            mayor = valor;
                        }
                        opcion = 2;
                        break;
                    case 3:
                        Console.WriteLine("el total recaudado es " + monto + " pesos la cantidad de ventas realizadas es " + ventas + " la venta mas alta fue de " + mayor + " pesos");
                        opcion = 3;
                        break;
                }
            }
        }
    }
}
