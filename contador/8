using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace ConsoleApplication2
{
    class Program
    {
        static void Main(string[] args)
        {
            int n = 0;
            int r = 0;
            for (int i = 1; i <= 7; i++)
            {
                Console.Write("ingrese la temperatura de hoy :");
                n = int.Parse(Console.ReadLine());
                if (n < 0)
                {
                    r = r + 1;
