                if (nc[2] == 0)
                {
                    nc[3] = nc[2];
                }
            }
            if (nc[0] == 0 & nc[3] != 0)
            {
                if(nc[1] == 0)
                {
                    Console.WriteLine("el numero es primo");
                }
                else
                {
