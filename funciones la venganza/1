namespace ConsoleApplication1
{
    class Program
    {
        static void Main(string[] args)
        {
            int nc;
            int pares = 0;
            int inpares = 0;
            int menor = 1213;
            int mayor;
            int numero = 0;
            int m = 0;
            int suma = 0;
            int promedio = 0;
            string condicion;
            do
            {
             promedio++;
             Console.Write("ingrese un numero: ");
             numero = int.Parse(Console.ReadLine());
             mayor = determinar_mayor(numero, m);
             menor = determinar_menor(numero, menor);
