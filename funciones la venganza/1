        static int determinar_mayor(int a, int b)
        {
         if (a > b)
          {
            b = a;
          }
            return b;
        }
        static int determinar_menor(int num, int me)
        {
            if (num < me)
            {
                me = num;
            }
            return me;
        }
        static int sacar_promedio (int nume, int u )
        {
         int pro;
         pro = nume / u;
            return pro;
        }
        static int determinar_par (int mun)
        {
            int con;
            if (mun % 2 ==0)
            {
                con = 1;
            }
            else
            {
                con = 0;
            }
            return con;
        }
    }
