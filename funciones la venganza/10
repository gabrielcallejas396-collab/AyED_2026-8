using System;

namespace ConsoleApplication2
{
    class Program
    {
        static void Main(string[] args)
        {
            Console.Write("Ingrese un numero entero positivo: ");
            int numero = int.Parse(Console.ReadLine());

            mostrar(numero);
        }

        static int determinar(int numero, int inicio, int cantidad)
        {
            int suma = 0;

            for (int i = 0; i < cantidad; i++)
            {
                suma = suma + inicio + i;
            }

            if (suma == numero)
            {
                return 1;
            }
            else
            {
                return 0;
            }
        }

        static void mostrar(int numero)
        {
            int cantidad = 2;
            int inicio = 1;
            int encontro = 0;

            Console.WriteLine("Representaciones posibles:");

            while (inicio < numero)
            {
                cantidad = 2;

                while (cantidad < numero)
                {
                    if (determinar(numero, inicio, cantidad) == 1)
                    {
                        for (int i = 0; i < cantidad; i++)
                        {
                            Console.Write(inicio + i);

                            if (i < cantidad - 1)
                            {
                                Console.Write(" + ");
                            }
                        }

                        Console.WriteLine(" = " + numero);
                        encontro++;
                    }

                    cantidad++;
                }

                inicio++;
            }

            if (encontro == 0)
            {
                Console.WriteLine("No se encontraron representaciones.");
            }
        }
    }
}
